# Copy to .env and fill in. Never commit .env.
# Only needed for the optional AI co-host in ttx host. Claude Code uses your Claude account, not this key.
ANTHROPIC_API_KEY=
# Optional co-host settings (see docs/CLI.md): TTX_HOST_MODEL, TTX_HOST_EFFORT, TTX_HOST_FAST, TTX_HOST_AI
# Only needed for live mode (ttx seed --mode tenable). Read-only keys are enough.
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
